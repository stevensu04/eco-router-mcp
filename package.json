{
  "name": "eco-router-mcp",
  "version": "0.1.0",
  "mcpName": "io.github.stevensu04/eco-router-mcp",
  "description": "MCP server that helps AI agents pick the lowest-carbon cloud region for a workload.",
  "type": "module",
  "license": "MIT",
  "author": "Steven Su",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stevensu04/eco-router-mcp.git"
  },
  "homepage": "https://github.com/stevensu04/eco-router-mcp#readme",
  "bugs": {
    "url": "https://github.com/stevensu04/eco-router-mcp/issues"
  },
  "bin": {
    "eco-router-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "update:baseline": "tsx scripts/update-baseline.ts",
    "update:egrid": "tsx scripts/update-egrid.ts",
    "update:canada": "tsx scripts/update-canada.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "carbon-aware",
    "green-software",
    "cloud-regions"
  ],
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^22.20.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
