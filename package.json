{
  "name": "eco-router-mcp",
  "version": "0.1.0",
  "description": "MCP server that helps AI agents pick the lowest-carbon cloud region for a workload.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "eco-router-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
